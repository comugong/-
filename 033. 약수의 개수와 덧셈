using System;

public class Solution {
    public int solution(int left, int right) {
        int result = 0;
        
        for (int i = left; i <= right; ++i) {
            int root = (int)Math.Sqrt(i);
            
            if (root * root == i) result -= i;
            else result += i;
        }
        
        return result;
    }
}

