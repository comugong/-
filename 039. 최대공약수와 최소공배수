def GCD(a, b):
    r = a % b

    if r == 0:
        return b

    a = b
    b = r

    return GCD(a, b)

def solution(n, m):
    result = []

    result.append(GCD(n, m))
    result.append(n * m // GCD(n, m))

    return result
